{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // "node" is needed only by src/data/__tests__/provenance.test.ts, which checks that every
    // record's `spriteFile` names a file that actually exists on disk (tasks.md T116/T118) --
    // a check that necessarily touches the filesystem. @types/node is already present
    // transitively; this only makes it visible to the type checker.
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /*
     * `erasableSyntaxOnly` REMOVED 2026-10-07 (round 7).
     *
     * It arrived as a Vite `react-ts` scaffold default in the initial commit -- nobody here chose
     * it -- and it bans `enum`, `namespace`, parameter properties and TS import aliases, because
     * those need code generation rather than type erasure.
     *
     * Measured before removing: nothing in this toolchain needs erasure-only syntax. `tsc -b`,
     * `vitest`, `vite build` and `tsx` all handle enums; no script runs a `.ts` file through a
     * strip-only runtime. So the flag was protecting a capability with zero consumers while
     * blocking the closed-vocabulary representation the data model actually wants.
     *
     * The guardrail half of its value is kept deliberately instead: every enum here is a STRING
     * enum with explicit initialisers. Numeric enums -- the real footgun, with reverse mappings and
     * arbitrary numbers assignable -- are not used, and neither is `namespace`.
     */
    "noFallthroughCasesInSwitch": true,

    /* Strictness (Constitution Principle II) */
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests"]
}

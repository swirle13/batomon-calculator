{
  "name": "batomon-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DPS and status-effect-per-second calculator for Batomon Showdown, with a cited creature/trainer/trinket/item corpus.",
  "homepage": "https://swirle13.github.io/batomon-calculator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swirle13/batomon-calculator.git"
  },
  "author": {
    "name": "Matthew Johnson",
    "url": "https://github.com/swirle13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "17.6.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
